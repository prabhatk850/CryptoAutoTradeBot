# Copy to .env. Every setting and its default lives in backend/config.py; only overrides belong here.
# Docker reads this file when a container is CREATED: run `docker compose up -d --force-recreate backend` after edits.

# --- Delta Exchange testnet (https://testnet.delta.exchange -> Profile -> API Keys) ---
DELTA_API_KEY=your_testnet_api_key
DELTA_API_SECRET=your_testnet_api_secret
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org

# --- MongoDB: Atlas SRV URI, or mongodb://mongodb:27017/forexbot with `docker compose --profile localdb up` ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/forexbot

# --- Symbols & cadence ---
TRADE_SYMBOLS=BTCUSD,ETHUSD
CHECK_INTERVAL_SECONDS=120        # deep loop; the fast loop runs every FAST_CHECK_SECONDS
FAST_CHECK_SECONDS=15

# --- AI providers (chains are defined in backend/bot/ai_brain.py) ---
AI_ENABLED=true
AI_MODE=decide                    # decide | refine | advisory
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=               # only used if "openrouter" is re-added to a chain
AGENTROUTER_API_KEY=              # only used if "agentrouter" is re-added to a chain (~$0.28/call)
AI_ALLOW_SUBSCRIPTION_CLI=false   # never spend the personal Claude subscription

# --- News ---
NEWS_ENABLED=true
NEWS_BLACKOUT_MIN=15              # no new entries ± this many minutes of a high-impact event
