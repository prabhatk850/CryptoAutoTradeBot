# Delta Exchange Testnet (paper trading)
# Create keys at https://testnet.delta.exchange -> Profile -> API Keys
DELTA_API_KEY=your_testnet_api_key
DELTA_API_SECRET=your_testnet_api_secret
DELTA_BASE_URL=https://testnet-api.delta.exchange

# MongoDB (local default, or paste your Atlas SRV URI)
MONGO_URI=mongodb://localhost:27017/forexbot

# Bot config
TRADING_SYMBOL=BTCUSDT
TRADE_QUANTITY=1
CHECK_INTERVAL_MINUTES=5

# EMA settings
EMA_FAST=9
EMA_SLOW=21

# RSI settings
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Market news + economic calendar (all optional — sensible defaults in config.py)
# ForexFactory has no news API, so headlines are aggregated from forex/crypto RSS feeds;
# the forecast/calendar table uses ForexFactory's official weekly JSON.
NEWS_ENABLED=true
NEWS_AI_CONTEXT=true          # feed upcoming events + headlines into the AI each tick
NEWS_BLACKOUT_MIN=15          # skip opening NEW trades within N min of a High-impact event (0 = off)
NEWS_CURRENCIES=USD,EUR,GBP,JPY,CNY
NEWS_REFRESH_SEC=180

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
